# Vemee Development Authentication
VEMEE_DEV_OTP=6666

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for signup/login to write/read profiles in the database
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Phone SMS OTP via Supabase (requires Phone provider configured in Dashboard)
# Keep false until Twilio/MessageBird/etc. is set up — otherwise use VEMEE_DEV_OTP
VEMEE_USE_SUPABASE_PHONE_OTP=false

# Admin login (development bootstrap)
VEMEE_ADMIN_EMAIL=admin@vemee.local
VEMEE_ADMIN_PASSWORD=admin123456
VEMEE_ADMIN_SESSION_SECRET=change-me-in-production

NEXT_PUBLIC_SITE_URL=http://localhost:3000
